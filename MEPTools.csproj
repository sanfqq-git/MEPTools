<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 保持原框架，不升级 -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MEPTools</RootNamespace>
    <AssemblyName>MEPTools</AssemblyName>

    <!-- Revit 2022 是 x64，必须 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>

    <!-- 启用 WPF：这一行是修复 InitializeComponent 的关键 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 保持原输出目录结构 -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- 兼容旧行为 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <FileAlignment>512</FileAlignment>

    <!-- 关闭默认项会带来麻烦，这里保持默认开启（自动包含 .cs/.xaml） -->
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API（路径不变） -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2022\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2022\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\Revit 2022\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- 零依赖 xlsx 读写用到的框架自带程序集（.NET Framework 内建，非 NuGet，不引入版本冲突） -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- Ribbon 图标：Resources 下的 png 编进程序集，供 App.cs 的 pack:// 路径读取 -->
  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <!-- 防止 obj/bin 下的自动生成文件被重复编译（SDK 默认已排除，这里双保险） -->
  <ItemGroup>
    <Compile Remove="**\obj\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <None Remove="**\obj\**" />
    <None Remove="**\bin\**" />
  </ItemGroup>

</Project>