using System;
using System.Reflection;
using System.Windows.Media.Imaging;
using Autodesk.Revit.UI;

namespace MEPTools
{
    public class App : IExternalApplication
    {
        private const string PanelName = "MEP 工具";
        private const string TabName = "MEP工具";

        public Result OnStartup(UIControlledApplication application)
        {
            // ---------- 1. 创建 Ribbon 选项卡 ----------
            try
            {
                application.CreateRibbonTab(TabName);
            }
            catch (Autodesk.Revit.Exceptions.ArgumentException) { /* 已存在则忽略 */ }

            // ---------- 2. 创建或获取面板 ----------
            RibbonPanel panel = null;
            foreach (RibbonPanel p in application.GetRibbonPanels(TabName))
            {
                if (p.Name == PanelName) { panel = p; break; }
            }
            if (panel == null)
                panel = application.CreateRibbonPanel(TabName, PanelName);

            string asmPath = Assembly.GetExecutingAssembly().Location;

            // =====================================================================
            // 第一组：连接工具 (使用 PulldownButton 折叠)
            // =====================================================================
            PulldownButtonData connData = new PulldownButtonData("ConnectionTools", "连接工具");
            PulldownButton connPulldown = panel.AddItem(connData) as PulldownButton;
            if (connPulldown != null)
            {
                connPulldown.ToolTip = "MEP 管道/风管连接工具集合";
                // 建议给下拉主按钮设置一个图标，如果有的话
                // connPulldown.Image = LoadImage("连接工具_16.png");
                
                // 添加子按钮
                AddSubButton(connPulldown, asmPath, "三通连接", "MEPTools.MEP3TeeConnect.MEP3TeeConnectCommand", "自动识别并连接管道/风管，生成三通");
                AddSubButton(connPulldown, asmPath, "四通连接", "MEPTools.MEP3TeeCrossConnect.MEP3TeeCrossConnectCommand", "自动识别并连接管道/风管，生成四通");
                AddSubButton(connPulldown, asmPath, "高低连接", "MEPTools.MEPHighLowConnector.MEPHighLowConnectorCommand", "在不同标高的 MEP 元素之间自动生成连接");
                AddSubButton(connPulldown, asmPath, "平面连接", "MEPTools.MEPPlanarConnector.MEPPlanarConnectorCommand", "在同一平面内的 MEP 元素之间自动生成连接");
            }

            // 加入分隔线
            panel.AddSeparator();

            // =====================================================================
            // 第二组：翻弯工具 (使用 PulldownButton 折叠)
            // =====================================================================
            PulldownButtonData bendData = new PulldownButtonData("BendTools", "翻弯工具");
            PulldownButton bendPulldown = panel.AddItem(bendData) as PulldownButton;
            if (bendPulldown != null)
            {
                bendPulldown.ToolTip = "MEP 翻弯与升降工具集合";
                // bendPulldown.Image = LoadImage("翻弯工具_16.png");

                AddSubButton(bendPulldown, asmPath, "高低翻弯", "MEPTools.MEPHighLowSaddleBend.MEPHighLowSaddleBendCommand", "高低差生成马鞍翻弯：先选A再选B组，B组相对A组");
                AddSubButton(bendPulldown, asmPath, "平面侧翻弯", "MEPTools.MEPPlanarLateralBend.MEPPlanarLateralBendCommand", "在水平面内两组MEP 元素之间生成拐弯侧向翻弯");
                AddSubButton(bendPulldown, asmPath, "平面翻弯", "MEPTools.MEPPlanarSaddleBend.MEPPlanarSaddleBendCommand", "在平面内两组MEP 元素之间生成马鞍翻弯");
                AddSubButton(bendPulldown, asmPath, "高低抬升/下降", "MEPTools.MEPHighLowUpDown.MEPHighLowUpDownCommand", "对单侧 MEP 元素进行抬升或下降操作");
            }

            // 加入分隔线
            panel.AddSeparator();

            // =====================================================================
            // 第三组：对齐与排序 (平铺显示)
            // =====================================================================
            AddPushButton(panel, asmPath, "底部平齐", "MEPTools.MEPAlignBottomElevation.AlignMEPBottomElevationCommand", "将选中的 MEP 元素底部标高对齐到指定的基准");
            AddPushButton(panel, asmPath, "分组排序对齐", "MEPTools.MEPGroupSortAlign.MEPGroupSortAlignCommand", "按底部标高分组，组内按净间距自动排布");
            AddPushButton(panel, asmPath, "标记左对齐", "MEPTools.TagAlignLeft.TagAlignLeftCommand", "将选中的标记（Tag）统一左对齐到 MEP 元素");

            // 加入分隔线
            panel.AddSeparator();

            // =====================================================================
            // 第四组：其他辅助工具 (平铺显示)
            // =====================================================================
            AddPushButton(panel, asmPath, "链接墙洞", "MEPTools.LinkElementWallHole.LinkElementWallHoleCommand", "在链接模型（如建筑墙）上批量创建墙洞");
            AddPushButton(panel, asmPath, "删除重复图元", "MEPTools.RemoveDuplicateElements.RemoveDuplicateElementsCommand", "查找并删除当前视图中重复的 MEP 图元");
            AddPushButton(panel, asmPath, "标高重命名", "MEPTools.RevitElevationRenamer.RevitElevationRenamerCommand", "批量重命名或规范化 Revit 标高名称");
            AddPushButton(panel, asmPath, "系统检查", "MEPTools.SystemChecker.SystemCheckerCommand", "检查 MEP 系统的连通性及参数完整性");

            return Result.Succeeded;
        }

        public Result OnShutdown(UIControlledApplication application) => Result.Succeeded;

        // =====================================================================
        // 帮助方法：添加下拉菜单子按钮
        // =====================================================================
        private static void AddSubButton(PulldownButton pulldown, string asmPath, 
            string text, string className, string tooltip)
        {
            PushButtonData data = new PushButtonData(className, text, asmPath, className);
            PushButton btn = pulldown.AddPushButton(data);
            if (btn != null)
            {
                btn.ToolTip = tooltip;
                ApplyIcon(btn, text);
            }
        }

        // =====================================================================
        // 帮助方法：添加普通平铺按钮
        // =====================================================================
        private static void AddPushButton(RibbonPanel panel, string asmPath, 
            string text, string className, string tooltip)
        {
            PushButtonData data = new PushButtonData(className, text, asmPath, className);
            PushButton btn = panel.AddItem(data) as PushButton;
            if (btn != null)
            {
                btn.ToolTip = tooltip;
                ApplyIcon(btn, text);
            }
        }

        // =====================================================================
        // 帮助方法：应用图标 (容错处理)
        // =====================================================================
        private static void ApplyIcon(PushButton btn, string text)
        {
            try
            {
                btn.LargeImage = LoadImage(text + "_32.png");  // 32x32
                btn.Image = LoadImage(text + "_16.png");       // 16x16
            }
            catch
            {
                // 没有图标不影响使用
            }
        }

        private static BitmapImage LoadImage(string fileName)
        {
            Uri uri = new Uri($"pack://application:,,,/MEPTools;component/Resources/{fileName}", UriKind.Absolute);
            return new BitmapImage(uri);
        }
    }
}