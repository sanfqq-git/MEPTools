<Window x:Class="MEPTools.FilterCopy.Views.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="执行结果" Width="620" Height="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="执行日志（含模板安全跳过明细）">
            <ListView ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>

        <Button Grid.Row="2" Content="确定" Width="90" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Margin="0,10,0,0"/>
    </Grid>
</Window>
